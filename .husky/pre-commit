#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔍 Executando validação local de qualidade (Pre-commit)..."

# 1. Executar Linter
npm run lint || { echo "❌ Falha no Linter"; exit 1; }

# 2. Checagem Estática de Tipos
npm run type-check || { echo "❌ Falha na verificação de tipos"; exit 1; }

# 3. Executar Testes Unitários com Cobertura
npm run test:coverage || { echo "❌ Testes falharam ou cobertura < 95%"; exit 1; }

echo "✅ Todas as validações locais passaram com sucesso!"